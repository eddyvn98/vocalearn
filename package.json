{
  "name": "vocalearn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/main.js",
    "dev": "node --watch server/main.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test",
    "build:sw": "node scripts/build-sw.js",
    "feature:check": "node scripts/feature-check.js",
    "preview:fixtures": "node --experimental-vm-modules scripts/preview.mjs",
    "db:verify": "node scripts/db-maintenance.js verify",
    "db:backup": "node scripts/db-maintenance.js backup",
    "db:restore": "node scripts/db-maintenance.js restore"
  },
  "dependencies": {
    "fflate": "0.8.3"
  }
}
