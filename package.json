{
  "name": "vocalearn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/main.js",
    "dev": "node --watch server/main.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test",
    "build:sw": "node scripts/build-sw.js",
    "backup": "node scripts/backup.js",
    "restore:verify": "node scripts/restore-verify.js",
    "preview:fixtures": "node --experimental-vm-modules scripts/preview.mjs",
    "lexicon:install": "node scripts/install-lexical-db.js"
  }
}
