HOST=127.0.0.1
PORT=3000
DB_PATH=./data/vocalearn.sqlite
# Optional read-only lexical database. Install with: npm run lexicon:install
LEXICAL_DB_PATH=./data/dictionary.db
ALLOW_SIGNUP=true

# Operational limits (single-process defaults)
MAX_REQUEST_BYTES=8388608
MAX_SYNC_EVENTS=200
MAX_ACCOUNT_EVENTS=50000
MAX_ACTIVE_SESSIONS=20
AUTH_ATTEMPTS=20
AUTH_WINDOW_SECONDS=600
RESET_ATTEMPTS=6
RESET_WINDOW_SECONDS=1800

# Password recovery. "return-token" is development-only.
# "resend" sends password reset mail directly through Resend.
PASSWORD_RESET_MODE=disabled
PASSWORD_RESET_TTL_MINUTES=30
# PASSWORD_RESET_PROVIDER_URL=https://mailer.example/reset-hook
# PASSWORD_RESET_PROVIDER_TOKEN=replace-with-a-long-random-secret
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=VocaLearn <noreply@example.com>

# For production only, serve behind an HTTPS reverse proxy:
# NODE_ENV=production
# APP_ORIGIN=https://your-host.example
# ALLOW_SIGNUP=false
# Public production signup requires PASSWORD_RESET_MODE=webhook or resend.

# Phase 2 AI. Point this at a self-hosted OpenAI-compatible endpoint
# such as Ollama/vLLM deployed in your own infrastructure. No paid provider is required.
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=qwen2.5:3b
# AI_API_KEY=
# AI_TIMEOUT_SECONDS=30
